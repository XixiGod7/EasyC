{
  "name": "easyc-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "check": "tsc --noEmit",
    "test": "node --test cloudflare/feedback.test.ts web/ai-client.test.js web/compiler-core.test.js web/code-editor.test.js scripts/exercise-catalog.test.mjs",
    "test:compiler": "node scripts/verify-compiler.mjs",
    "test:exercises": "node scripts/verify-exercises.mjs",
    "build:web": "node scripts/prepare-web.mjs && vite build",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "npm run build:web && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@wasmer/sdk": "0.19.1",
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261021.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.151.3"
  }
}
