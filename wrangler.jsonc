{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easyc",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-10-21",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "EasyCContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "EASYC_CONTAINER", "class_name": "EasyCContainer" }
    ]
  },
  "exports": {
    "EasyCContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
